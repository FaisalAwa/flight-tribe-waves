# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Higgsfield media — scratch generations, large files, never commit
public/assets/*.mp4
public/assets/*.mov
public/assets/*.jpg
public/assets/*.jpeg
public/assets/*.png
public/assets/*.webp
public/assets/*.gif
!public/assets/.gitkeep

# …except the shipped hero/section media. These are referenced directly by
# HeroReveal / ChromeField / Tribe, so a build without them renders an empty
# black hero. They used to reach production only because the site was deployed
# from this machine with the Vercel CLI (which ignores .gitignore); on a
# GitHub-driven build they 404. ~11 MB total — small enough to commit.
!public/assets/hero-dice-roll.mp4
!public/assets/hero-dice-roll.jpg
!public/assets/hero-atmosphere.mp4
!public/assets/hero-atmosphere-poster.jpg
!public/assets/bandana-meadow.mp4
!public/assets/bandana-meadow-poster.jpg

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.vercel

# secrets — Shopify Admin token must never be committed
.env
.env.*
!.env.example

# agent worktrees, dev artifacts, crash dumps
.claude/worktrees/
*.stackdump
*.pid
vite-dev.log
.gstack/
