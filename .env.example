# ── Storefront (public, safe to ship in the browser bundle) ──────────
# Copy to .env for local dev, and set the same values in Vercel.
VITE_SHOPIFY_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=
VITE_SHOPIFY_API_VERSION=2026-07

# ── Admin (SECRET — never commit, never expose to the browser) ────────
# Used only by scripts/shopify/*.mjs. Put these in .env.shopify instead.
#   SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
#   SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
